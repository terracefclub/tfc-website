#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
if git diff --cached --quiet; then
  exit 0
fi

# Scan the whole staged patch. Suppress diagnostics so a failed scan cannot
# print a candidate value, even if a future gitleaks release changes output.
if git diff --cached --no-ext-diff --no-color --unified=0 |
  gitleaks stdin --redact=100 --no-banner > /dev/null 2>&1; then
  exit 0
fi

echo 'Staged changes failed the redacted secret scan.' >&2
exit 1
