[run]
branch = True
omit = website/**/tests/*, website/tests/*
data_file = .coverage/backend/data_file

[report]
skip_covered = True

[html]
directory = .coverage/backend/htmlcov
title = "Backend Test Coverage Report"

[xml]
output = .coverage/backend/coverage.xml

[json]
output = .coverage/backend/coverage.json
pretty_print = True
