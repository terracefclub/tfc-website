  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend",
      "type": "pwa-node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "test",
        "--watchAll"
      ],
      "cwd": "${workspaceFolder}/website/frontend",
      "protocol": "inspector",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Backend",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/manage.py",
      "args": [
        "test",
        "website/blog/tests/test_models.py::BlogIndexPageTests::test_get_live_blogpages_antichronological"
      ],
      "cwd": "${workspaceFolder}",
      "django": true
    }
  ]
}