#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ ! -f .state/local.env ]]; then echo 'Run tools/local-up first.' >&2; exit 1; fi
set -a
# shellcheck disable=SC1091
source .state/local.env
set +a
export DATABASE_URI="postgresql:///terrace_cms?host=$PWD/.state/postgres-socket&port=55432"
exec "$@"
