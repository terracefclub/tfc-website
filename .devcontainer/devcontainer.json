{
	"name": "TFC Website",

  "dockerComposeFile": "docker-compose.yaml",
  "service": "server",
  "workspaceFolder": "/usr/src/womb",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8888],

  // add common development tools
  "postCreateCommand": "bash .devcontainer/install-dev-tools.sh",

  "userEnvProbe": "loginInteractiveShell",

	"settings": { 
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": true 
    },
    "editor.bracketPairColorization.enabled": true,

    "emmet.includeLanguages": {
      "django-html": "html"
    },

    "files.associations": {
      "**/*.html": "html",
      "**/templates/**/*.html": "django-html",
      "**/templates/**/*": "django-txt",
      "**/requirements{/**,*}.{txt,in}": "pip-requirements",
      "*.yaml": "yaml",
      "*.scss": "scss"
    },

    "git.path": ["/usr/bin/git", "C:\\Program Files\\Git\\cmd\\git.exe"],

    "python.languageServer": "Pylance",
    "python.testing.pytestArgs": [
      "."
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.nosetestsEnabled": false,
    "python.testing.pytestEnabled": true,

    "css.validate": false,
    "scss.validate": false,
    "stylelint.enable": true,
    "stylelint.configFile": "frontend/.stylelintrc.json",
    
    "terminal.integrated.profiles.linux": {
      "zsh -l": {
        "path": "/bin/zsh",
        "args": ["-l"],
      },
    },
	},

	// Extensions to be installed when container is created
	"extensions": [
    "batisteo.vscode-django",
    "eamodio.gitlens",
    "ms-python.python",
    "bradlc.vscode-tailwindcss",
    "ritwickdey.liveserver",
    "tim-koehler.helm-intellisense",
    "ipedrazas.kubernetes-snippets",
    "stylelint.vscode-stylelint",
    "tomoki1207.pdf",
    "lextudio.restructuredtext",
    "trond-snekvik.simple-rst",
    "mtxr.sqltools",
    "ms-azuretools.vscode-docker",
    "run-at-scale.terraform-doc-snippets"
  ],
}
