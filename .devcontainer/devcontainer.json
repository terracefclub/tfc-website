{
    "name": "TFC Website",
    "context": "..",
    "dockerFile": "../docker/Dockerfile.dev",
    "postCreateCommand": "bash .devcontainer/install-dev-tools.sh",
    "userEnvProbe": "loginInteractiveShell",
    "remoteEnv": {
        "PATH": "${localEnv:HOME}/.local/bin:${containerEnv:PATH}",
        "GOOGLE_CREDENTIALS": "${localEnv:GOOGLE_CREDENTIALS}"
    },
    "settings": {
        "git.path": ["/usr/bin/git", "C:\\Program Files\\Git\\cmd\\git.exe"]
    },
    "extensions": [
        "batisteo.vscode-django",
        "eamodio.gitlens",
        "ms-python.python",
        "bradlc.vscode-tailwindcss",
        "ritwickdey.liveserver",
        "tim-koehler.helm-intellisense",
        "ipedrazas.kubernetes-snippets",
        "stylelint.vscode-stylelint",
        "tomoki1207.pdf",
        "lextudio.restructuredtext",
        "trond-snekvik.simple-rst",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "ms-azuretools.vscode-docker",
        "4ops.terraform",
        "hashicorp.terraform",
        "run-at-scale.terraform-doc-snippets",
        "emeraldwalk.runonsave"
    ]
}
