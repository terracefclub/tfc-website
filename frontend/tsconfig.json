{
  "compilerOptions": {
          
    /* avoids file extension caveats */
    "module": "esnext",
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],

    "downlevelIteration": true,

    "importHelpers": true,

    /* necessary with Webpack */
    "noEmit": true,

    "sourceMap": true,

    /* strict type-checking */
    "noImplicitAny": true,
    "strict": true,
    "strictNullChecks": true,

    /* module resolution */
    "declaration": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,

    "types": [
        "reflect-metadata",
        "jest"
    ],

    "typeRoots": [
      "./common/types",
      "./main/scripts/types",
      "./node_modules/@types"
    ]
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "public"],
  "typedocOptions": {
    "entryPoints": [
        "src/main/scripts/index.ts",
        "src/admin/scripts/index.ts"
    ]
  }
}