{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python",
            "type": "python",
            "request": "launch",
            "stopOnEntry": false,
            "program": "${file}",
            "cwd": "${workspaceRoot}/backend",
            "debugOptions": [
                "WaitOnAbnormalExit",
                "WaitOnNormalExit",
                "RedirectOutput"
            ]
        },
        {
            "name": "Django",
            "type": "python",
            "request": "launch",
            "program": "manage.py",
            "cwd": "${workspaceRoot}",
            "args": [
                "runserver"
            ],
            "env": {
                "CLOUD_MEDIA": "1"
            }
        }
    ]
}