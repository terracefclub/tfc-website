{
  "name": "tfc_website_frontend",
  "description": "Frontend static and scripts for TFC website",
  "scripts": {
    "build": "TAILWIND_DISABLE_TOUCH=true webpack --mode production --color",
    "dev:build": "TAILWIND_DISABLE_TOUCH=true webpack --watch",
    "dev:serve": "webpack serve --open --hot",
    "lint": "stylelint './src/scss/**/*.scss' && eslint src --fix",
    "test": "jest --runInBand",
    "sandbox": "TAILWIND_DISABLE_TOUCH=true postcss ./sandbox/index.css -o ./sandbox/dist.css -w"
  },
  "target": "web",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/terracefclub/tech/tfc-website.git"
  },
  "keywords": [],
  "author": "Tristan Schrader",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/plugin-proposal-class-properties": "^7.12.1",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.12.7",
    "@babel/preset-typescript": "^7.13.0",
    "@tailwindcss/jit": "^0.1.18",
    "@types/isomorphic-fetch": "0.0.35",
    "@types/jest": "^26.0.23",
    "@types/pdfjs-dist": "^2.7.1",
    "@typescript-eslint/eslint-plugin": "^4.22.0",
    "@typescript-eslint/parser": "^4.22.0",
    "autoprefixer": "^10.0.2",
    "babel-jest": "^26.6.3",
    "babel-loader": "^8.2.2",
    "clean-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "^6.4.0",
    "css-loader": "^5.0.1",
    "eslint": "^7.15.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-prettier": "^3.4.0",
    "file-loader": "^6.2.0",
    "husky": "^6.0.0",
    "jest": "^26.6.3",
    "lint-staged": "^10.5.4",
    "mini-css-extract-plugin": "^1.3.2",
    "postcss": "^8.2.15",
    "postcss-cli": "^8.3.1",
    "postcss-loader": "^4.1.0",
    "prettier": "^2.2.1",
    "sass": "^1.32.8",
    "sass-loader": "^10.1.0",
    "style-loader": "^2.0.0",
    "stylelint": "^13.8.0",
    "stylelint-config-recommended": "^3.0.0",
    "stylelint-config-standard": "^20.0.0",
    "stylelint-scss": "^3.19.0",
    "stylelint-webpack-plugin": "^2.1.1",
    "tailwindcss": "^2.0.1",
    "ts-jest": "^26.5.6",
    "tslib": "^2.2.0",
    "typedoc": "^0.20.36",
    "typescript": "^4.2.4",
    "webpack": "^5.36.2",
    "webpack-bundle-analyzer": "^4.4.1",
    "webpack-cli": "^4.5.0",
    "webpack-dev-server": "^3.11.2",
    "webpack-merge": "^5.4.0"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "core-js": "^3.8.1",
    "events": "^3.3.0",
    "isomorphic-fetch": "^3.0.0",
    "pdfjs-dist": "^2.6.347",
    "rxjs": "^6.6.6"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix"
    ]
  },
  "browserslist": {
    "production": [
      "> 5%",
      "last 2 versions",
      "Firefox ESR",
      "not ie < 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 edge version"
    ]
  }
}
