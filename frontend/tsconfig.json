{
  "compilerOptions": {
          
    /* avoids file extension caveats */
    "module": "ESNext",
    "target": "ES5",
    "lib": [
      "ES2015",
      "ES2016",
      "ES2017",
      "ES2018",
      "ES2019",
      "ES2020",
      "ESNext",
      "dom",
      "dom.iterable"
    ],

    "downlevelIteration": true,

    "importHelpers": true,

    /* necessary with Webpack */
    "noEmit": true,

    "sourceMap": true,

    /* strict type-checking */
    "noImplicitAny": true,
    "strict": true,
    "strictNullChecks": true,

    /* module resolution */
    "declaration": true,
    "moduleResolution": "node",
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,

    "types": [
        "reflect-metadata",
        "jest"
    ],

    "typeRoots": [
      "./common/types",
      "./main/scripts/types",
      "./node_modules/@types"
    ]
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "public"],
  "typedocOptions": {
    "entryPoints": ["src/main/scripts/index.ts"]
  }
}